{
  "identifier": "default",
  "description": "Kubi window permissions",
  "windows": ["main", "log-*", "exec-*", "ctx-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:default",
    "process:default",
    "updater:default"
  ]
}
